          "name": "가입 유저 리스트",
          "request": {
            "name": "가입 유저 리스트",
            "description": {
              "content": "전체 가입자 리스트를 얻는다. 닉네임, 이메일, 기관코드로 필터링할 수 있다. 각 필터는 부분 문자열로 검색한다. loginId 필터는 과거호환성을 위해서 남겨둔다.\n\n**Usage:**\n- /?nickname={nickname}&...\n- /?email={email}&...\n- /?company={company}&...\n- /?nickname={nickname}&email={email}&...",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "bapi",
                "v1",
                "user"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "<integer>",
                  "description": "(Required) 페이지당 아이템 개수"
                },
                {
                  "disabled": false,
                  "key": "pageNum",
                  "value": "<integer>",
                  "description": "(Required) 페이지 넘버"
                },
                {
                  "disabled": false,
                  "key": "loginId",
                  "value": "<string>",
                  "description": "로그인 아이디"
                },
                {
                  "disabled": false,
                  "key": "nickname",
                  "value": "<string>",
                  "description": "닉네임"
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<string>",
                  "description": "이메일"
                },
                {
                  "disabled": false,
                  "key": "company",
                  "value": "<string>",
                  "description": "기관 코드"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
